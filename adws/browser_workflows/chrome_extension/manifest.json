{
  "manifest_version": 3,
  "name": "Browser Recorder (agent_blocks)",
  "version": "0.1.0",
  "description": "Records clicks, text entries and navigation in one tab you choose, for replay by browser_workflows. Never records passwords or other secrets.",
  "key": "",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "sw/main.js", "type": "module" },
  "permissions": [ "scripting", "storage", "tabs", "webNavigation", "alarms" ],
  "host_permissions": [ "<all_urls>" ],
  "action": { "default_popup": "popup/popup.html", "default_title": "Browser Recorder" },
  "web_accessible_resources": []
}
